# Environment Variables Template
# Copy this file to .env and add your actual API keys

# Google Gemini API Key (Optional - for AI chat feature)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative - if using OpenAI instead of Gemini)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Note: The application works with mock AI responses even without API keys
# API keys are only needed if you want to use real LLM providers
